            "Monday"
          ]
        },
        {
          "id": "u16-d01-q2",
          "question": "Where will they meet?",
          "answer": "The MRT station",
          "distractors": [
            "The cinema",
            "The park",
            "B's home"
          ]
        }
      ]
    },
    {
      "id": "u16-d02",
      "title": "A phone call",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "喂，你好，我是小王。",
          "pinyin": "Wèi, nǐ hǎo, wǒ shì Xiǎo Wáng.",
          "english": "Hello, it's Xiao Wang."
        },
        {
          "speaker": "B",
          "hanzi": "小王，你好！",
          "pinyin": "Xiǎo Wáng, nǐ hǎo!",
          "english": "Hi, Xiao Wang!"
        },
        {
          "speaker": "A",
          "hanzi": "今天晚上一起吃饭，好吗？",
          "pinyin": "Jīntiān wǎnshang yìqǐ chīfàn, hǎo ma?",
          "english": "Shall we have dinner together tonight?"
        },
        {
          "speaker": "B",
          "hanzi": "对不起啊，我今天要开会。",
          "pinyin": "Duìbuqǐ a, wǒ jīntiān yào kāihuì.",
          "english": "Sorry, I have a meeting today."
        },
        {
          "speaker": "A",
          "hanzi": "那明天呢？",
          "pinyin": "Nà míngtiān ne?",
          "english": "What about tomorrow?"
        },
        {
          "speaker": "B",
          "hanzi": "明天可以。",
          "pinyin": "Míngtiān kěyǐ.",
          "english": "Tomorrow works."
        },
        {
          "speaker": "A",
          "hanzi": "好，我给你打电话。",
          "pinyin": "Hǎo, wǒ gěi nǐ dǎ diànhuà.",
          "english": "Good, I'll call you."
        }
