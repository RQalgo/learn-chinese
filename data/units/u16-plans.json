  "dialogues": [
    {
      "id": "u16-d01",
      "title": "Inviting a friend",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "喂，你周末有空吗？",
          "pinyin": "Wèi, nǐ zhōumò yǒu kòng ma?",
          "english": "Hello, are you free at the weekend?"
        },
        {
          "speaker": "B",
          "hanzi": "星期六有空，怎么了？",
          "pinyin": "Xīngqīliù yǒu kòng, zěnme le?",
          "english": "I'm free on Saturday, why?"
        },
        {
          "speaker": "A",
          "hanzi": "我们一起看电影吧。",
          "pinyin": "Wǒmen yìqǐ kàn diànyǐng ba.",
          "english": "Let's watch a film together."
        },
        {
          "speaker": "B",
          "hanzi": "好啊，几点？",
          "pinyin": "Hǎo a, jǐ diǎn?",
          "english": "Sure, what time?"
        },
        {
          "speaker": "A",
          "hanzi": "下午三点，在地铁站见面。",
          "pinyin": "Xiàwǔ sān diǎn, zài dìtiězhàn jiànmiàn.",
          "english": "Three in the afternoon, meet at the MRT station."
        },
        {
          "speaker": "B",
          "hanzi": "没问题啦，星期六见！",
          "pinyin": "Méi wèntí la, xīngqīliù jiàn!",
          "english": "No problem, see you Saturday!"
        }
      ],
      "questions": [
        {
          "id": "u16-d01-q1",
          "question": "Which day is B free?",
          "answer": "Saturday",
          "distractors": [
