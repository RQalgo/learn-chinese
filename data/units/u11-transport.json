  "dialogues": [
    {
      "id": "u11-d01",
      "title": "Asking the way",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "请问，怎么去乌节路？",
          "pinyin": "Qǐngwèn, zěnme qù Wūjiélù?",
          "english": "Excuse me, how do I get to Orchard Road?"
        },
        {
          "speaker": "B",
          "hanzi": "你可以坐地铁。",
          "pinyin": "Nǐ kěyǐ zuò dìtiě.",
          "english": "You can take the MRT."
        },
        {
          "speaker": "A",
          "hanzi": "地铁站远吗？",
          "pinyin": "Dìtiězhàn yuǎn ma?",
          "english": "Is the MRT station far?"
        },
        {
          "speaker": "B",
          "hanzi": "不远，走路五分钟。",
          "pinyin": "Bù yuǎn, zǒulù wǔ fēnzhōng.",
          "english": "Not far, five minutes on foot."
        },
        {
          "speaker": "A",
          "hanzi": "谢谢！",
          "pinyin": "Xièxie!",
          "english": "Thank you!"
        },
        {
          "speaker": "B",
          "hanzi": "不客气。",
          "pinyin": "Bú kèqi.",
          "english": "You're welcome."
        }
      ],
      "questions": [
        {
          "id": "u11-d01-q1",
          "question": "How does B suggest getting to Orchard Road?",
          "answer": "Take the MRT",
          "distractors": [
            "Take a taxi",
            "Take a bus",
            "Walk the whole way"
          ]
        },
        {
          "id": "u11-d01-q2",
          "question": "How long is the walk to the station?",
          "answer": "Five minutes",
          "distractors": [
            "Ten minutes",
            "Fifteen minutes",
            "Twenty minutes"
          ]
        }
      ]
    },
