  "dialogues": [
    {
      "id": "u20-d01",
      "title": "Hotel check-in",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "您好，欢迎光临。",
          "pinyin": "Nín hǎo, huānyíng guānglín.",
          "english": "Hello, welcome."
        },
        {
          "speaker": "B",
          "hanzi": "你好，我预订了一个房间，我姓王。",
          "pinyin": "Nǐ hǎo, wǒ yùdìng le yí gè fángjiān, wǒ xìng Wáng.",
          "english": "Hello, I booked a room. My surname is Wang."
        },
        {
          "speaker": "A",
          "hanzi": "好的，王先生，请给我您的护照。",
          "pinyin": "Hǎo de, Wáng xiānsheng, qǐng gěi wǒ nín de hùzhào.",
          "english": "OK, Mr Wang, please give me your passport."
        },
        {
          "speaker": "B",
          "hanzi": "给你。",
          "pinyin": "Gěi nǐ.",
          "english": "Here you are."
        },
        {
          "speaker": "A",
          "hanzi": "您订了单人房，住三天，对吗？",
          "pinyin": "Nín dìng le dānrénfáng, zhù sān tiān, duì ma?",
          "english": "You booked a single room for three days, right?"
        },
        {
          "speaker": "B",
          "hanzi": "对。早饭几点开始？",
          "pinyin": "Duì. Zǎofàn jǐ diǎn kāishǐ?",
          "english": "Right. What time does breakfast start?"
        },
        {
          "speaker": "A",
          "hanzi": "早上七点到十点。房间在八楼，这是钥匙。",
          "pinyin": "Zǎoshang qī diǎn dào shí diǎn. Fángjiān zài bā lóu, zhè shì yàoshi.",
          "english": "From seven to ten in the morning. The room is on the eighth floor. Here is the key."
        },
        {
          "speaker": "B",
          "hanzi": "谢谢！",
          "pinyin": "Xièxie!",
          "english": "Thank you!"
        }
      ],
      "questions": [
        {
          "id": "u20-d01-q1",
          "question": "What kind of room did B book?",
          "answer": "A single room",
          "distractors": [
            "A double room",
            "A family suite",
            "A room with a sea view"
          ]
        },
        {
          "id": "u20-d01-q2",
          "question": "Which floor is the room on?",
          "answer": "The eighth floor",
          "distractors": [
            "The third floor",
            "The fifth floor",
            "The tenth floor"
          ]
        }
      ]
    },
    {
      "id": "u20-d02",
      "title": "Planning a trip",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "今年你想去哪里旅游？",
          "pinyin": "Jīnnián nǐ xiǎng qù nǎlǐ lǚyóu?",
          "english": "Where do you want to travel this year?"
        },
        {
          "speaker": "B",
          "hanzi": "我想去上海，机票已经买了。",
          "pinyin": "Wǒ xiǎng qù Shànghǎi, jīpiào yǐjīng mǎi le.",
          "english": "I want to go to Shanghai. I've already bought the ticket."
        },
        {
          "speaker": "A",
          "hanzi": "几号的飞机？",
          "pinyin": "Jǐ hào de fēijī?",
          "english": "Which date is the flight?"
        },
        {
          "speaker": "B",
          "hanzi": "十二号早上八点的。",
          "pinyin": "Shí'èr hào zǎoshang bā diǎn de.",
          "english": "The twelfth, at eight in the morning."
        },
        {
          "speaker": "A",
          "hanzi": "你有签证吗？",
          "pinyin": "Nǐ yǒu qiānzhèng ma?",
          "english": "Do you have a visa?"
        },
        {
          "speaker": "B",
          "hanzi": "有，我已经办好了。",
          "pinyin": "Yǒu, wǒ yǐjīng bàn hǎo le.",
          "english": "Yes, I've already arranged it."
        },
        {
          "speaker": "A",
          "hanzi": "酒店订了吗？",
          "pinyin": "Jiǔdiàn dìng le ma?",
          "english": "Have you booked a hotel?"
        },
        {
          "speaker": "B",
          "hanzi": "订了，住五天。你也去吗？",
          "pinyin": "Dìng le, zhù wǔ tiān. Nǐ yě qù ma?",
          "english": "Yes, for five days. Are you going too?"
        }
      ],
