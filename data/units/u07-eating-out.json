  "dialogues": [
    {
      "id": "u07-d01",
      "title": "Placing an order",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你好，想吃什么？",
          "pinyin": "Nǐ hǎo, xiǎng chī shénme?",
          "english": "Hello, what would you like to eat?"
        },
        {
          "speaker": "B",
          "hanzi": "我要一份鸡饭，一碗汤。",
          "pinyin": "Wǒ yào yí fèn jīfàn, yì wǎn tāng.",
          "english": "I'd like a chicken rice and a bowl of soup."
        },
        {
          "speaker": "A",
          "hanzi": "想喝什么？",
          "pinyin": "Xiǎng hē shénme?",
          "english": "What would you like to drink?"
        },
        {
          "speaker": "B",
          "hanzi": "一杯茶，谢谢。",
          "pinyin": "Yì bēi chá, xièxie.",
          "english": "A cup of tea, thank you."
        },
        {
          "speaker": "A",
          "hanzi": "好的，请等一下。",
          "pinyin": "Hǎo de, qǐng děng yíxià.",
          "english": "Okay, please wait a moment."
        }
      ],
