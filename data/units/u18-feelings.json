    {
      "id": "u18-d02",
      "title": "Talking about a film",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "昨天的电影你觉得怎么样？",
          "pinyin": "Zuótiān de diànyǐng nǐ juéde zěnmeyàng?",
          "english": "What did you think of yesterday's film?"
        },
        {
          "speaker": "B",
          "hanzi": "我觉得有点儿无聊，太长了。",
          "pinyin": "Wǒ juéde yǒudiǎnr wúliáo, tài cháng le.",
          "english": "I thought it was a bit boring, too long."
        },
        {
          "speaker": "A",
          "hanzi": "是吗？我觉得很有意思。",
          "pinyin": "Shì ma? Wǒ juéde hěn yǒu yìsi.",
          "english": "Really? I thought it was very interesting."
        },
        {
          "speaker": "B",
          "hanzi": "你为什么觉得有意思？",
          "pinyin": "Nǐ wèishénme juéde yǒu yìsi?",
          "english": "Why did you find it interesting?"
        },
        {
          "speaker": "A",
          "hanzi": "我很喜欢那个电影的音乐。",
          "pinyin": "Wǒ hěn xǐhuan nàge diànyǐng de yīnyuè.",
          "english": "I really like the music in that film."
        },
        {
          "speaker": "B",
          "hanzi": "音乐我同意，音乐很好听。",
          "pinyin": "Yīnyuè wǒ tóngyì, yīnyuè hěn hǎotīng.",
          "english": "I agree about the music. It sounds great."
        },
        {
          "speaker": "A",
          "hanzi": "下次我们再一起去看吧！",
          "pinyin": "Xià cì wǒmen zài yìqǐ qù kàn ba!",
          "english": "Let's go and watch one together again next time!"
        },
        {
          "speaker": "B",
          "hanzi": "好啊，不过这次我选。",
          "pinyin": "Hǎo a, búguò zhè cì wǒ xuǎn.",
          "english": "Sure, but this time I'll choose."
        }
      ],
