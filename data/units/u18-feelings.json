  "dialogues": [
    {
      "id": "u18-d01",
      "title": "A bad day",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你怎么了？不高兴吗？",
          "pinyin": "Nǐ zěnme le? Bù gāoxìng ma?",
          "english": "What's wrong? Are you unhappy?"
        },
        {
          "speaker": "B",
          "hanzi": "对，我今天很累，老板还生气了。",
          "pinyin": "Duì, wǒ jīntiān hěn lèi, lǎobǎn hái shēngqì le.",
          "english": "Yes. I'm very tired today and the boss got angry too."
        },
        {
          "speaker": "A",
          "hanzi": "为什么？",
          "pinyin": "Wèishénme?",
          "english": "Why?"
        },
        {
          "speaker": "B",
          "hanzi": "因为我的工作没做好。",
          "pinyin": "Yīnwèi wǒ de gōngzuò méi zuò hǎo.",
          "english": "Because my work wasn't done well."
        },
        {
          "speaker": "A",
          "hanzi": "别难过，明天会好的。",
          "pinyin": "Bié nánguò, míngtiān huì hǎo de.",
          "english": "Don't be sad. Tomorrow will be better."
        },
        {
          "speaker": "B",
          "hanzi": "谢谢你。我们去吃饭吧？",
          "pinyin": "Xièxie nǐ. Wǒmen qù chī fàn ba?",
          "english": "Thank you. Shall we go eat?"
        },
        {
          "speaker": "A",
          "hanzi": "太好了！我想吃面。",
          "pinyin": "Tài hǎo le! Wǒ xiǎng chī miàn.",
          "english": "Great! I want to eat noodles."
        }
      ],
      "questions": [
        {
