  "dialogues": [
    {
      "id": "u01-d01",
      "title": "Meeting a friend",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你好！好久不见。",
          "pinyin": "Nǐ hǎo! Hǎojiǔ bú jiàn.",
          "english": "Hello! Long time no see."
        },
        {
          "speaker": "B",
          "hanzi": "你好！你好吗？",
          "pinyin": "Nǐ hǎo! Nǐ hǎo ma?",
          "english": "Hello! How are you?"
        },
        {
          "speaker": "A",
          "hanzi": "我很好，谢谢。你呢？",
          "pinyin": "Wǒ hěn hǎo, xièxie. Nǐ ne?",
          "english": "I'm fine, thanks. And you?"
        },
        {
          "speaker": "B",
          "hanzi": "我也很好。明天见！",
          "pinyin": "Wǒ yě hěn hǎo. Míngtiān jiàn!",
          "english": "I'm fine too. See you tomorrow!"
        }
      ],
