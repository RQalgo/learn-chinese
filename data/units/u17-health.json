    {
      "id": "u17-d02",
      "title": "A sick day",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "喂，小王，你今天怎么没来上班？",
          "pinyin": "Wèi, Xiǎo Wáng, nǐ jīntiān zěnme méi lái shàngbān?",
          "english": "Hello, Xiao Wang, why didn't you come to work today?"
        },
        {
          "speaker": "B",
          "hanzi": "我生病了，肚子很疼。",
          "pinyin": "Wǒ shēngbìng le, dùzi hěn téng.",
          "english": "I'm sick. My stomach really hurts."
        },
        {
          "speaker": "A",
          "hanzi": "你看医生了吗？",
          "pinyin": "Nǐ kàn yīshēng le ma?",
          "english": "Have you seen a doctor?"
        },
        {
          "speaker": "B",
          "hanzi": "看了，我现在在家吃药。",
          "pinyin": "Kàn le, wǒ xiànzài zài jiā chī yào.",
          "english": "Yes. I'm at home taking medicine now."
        },
        {
          "speaker": "A",
          "hanzi": "好，你多休息，别想工作了。",
          "pinyin": "Hǎo, nǐ duō xiūxi, bié xiǎng gōngzuò le.",
          "english": "OK, rest more and don't think about work."
        },
        {
          "speaker": "B",
          "hanzi": "谢谢你，我明天可能就好了。",
          "pinyin": "Xièxie nǐ, wǒ míngtiān kěnéng jiù hǎo le.",
          "english": "Thank you. I might be fine tomorrow."
        },
        {
          "speaker": "A",
          "hanzi": "好，明天我再打电话。",
          "pinyin": "Hǎo, míngtiān wǒ zài dǎ diànhuà.",
          "english": "OK, I'll call again tomorrow."
        },
        {
          "speaker": "B",
          "hanzi": "好的，再见。",
          "pinyin": "Hǎo de, zàijiàn.",
          "english": "OK, goodbye."
        }
      ],
