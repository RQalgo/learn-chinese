  "dialogues": [
    {
      "id": "u17-d01",
      "title": "At the doctor's",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你好，你哪里不舒服？",
          "pinyin": "Nǐ hǎo, nǐ nǎlǐ bù shūfu?",
          "english": "Hello, where do you feel unwell?"
        },
        {
          "speaker": "B",
          "hanzi": "医生，我头疼，还咳嗽。",
          "pinyin": "Yīshēng, wǒ tóu téng, hái késou.",
          "english": "Doctor, I have a headache, and I cough too."
        },
        {
          "speaker": "A",
          "hanzi": "发烧吗？",
          "pinyin": "Fāshāo ma?",
          "english": "Do you have a fever?"
        },
        {
          "speaker": "B",
          "hanzi": "昨天晚上发烧了，今天好点了。",
          "pinyin": "Zuótiān wǎnshang fāshāo le, jīntiān hǎo diǎn le.",
          "english": "I had a fever last night; I'm a bit better today."
        },
        {
          "speaker": "A",
          "hanzi": "你感冒了。吃两天药，多喝水，多休息。",
          "pinyin": "Nǐ gǎnmào le. Chī liǎng tiān yào, duō hē shuǐ, duō xiūxi.",
          "english": "You have a cold. Take medicine for two days, drink more water and rest more."
        },
        {
          "speaker": "B",
          "hanzi": "谢谢医生。",
          "pinyin": "Xièxie yīshēng.",
          "english": "Thank you, doctor."
        },
        {
          "speaker": "A",
          "hanzi": "不客气。",
          "pinyin": "Bú kèqi.",
          "english": "You're welcome."
        }
      ],
