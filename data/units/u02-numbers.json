          "english": "No, it's six."
        },
        {
          "speaker": "A",
          "hanzi": "是六吗？",
          "pinyin": "Shì liù ma?",
          "english": "Is it six?"
        },
        {
          "speaker": "B",
          "hanzi": "对啊，是六。",
          "pinyin": "Duì a, shì liù.",
          "english": "Yes, it's six."
        },
        {
          "speaker": "A",
          "hanzi": "好的，谢谢！",
          "pinyin": "Hǎo de, xièxie!",
          "english": "Okay, thanks!"
        }
