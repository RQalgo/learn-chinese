  "dialogues": [
    {
      "id": "u19-d01",
      "title": "Visiting a friend's home",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "欢迎来我家！",
          "pinyin": "Huānyíng lái wǒ jiā!",
          "english": "Welcome to my home!"
        },
        {
          "speaker": "B",
          "hanzi": "谢谢！你家很大啊。",
          "pinyin": "Xièxie! Nǐ jiā hěn dà a.",
          "english": "Thanks! Your home is big."
        },
        {
          "speaker": "A",
          "hanzi": "我们住在组屋，有三个房间。",
          "pinyin": "Wǒmen zhù zài zǔwū, yǒu sān gè fángjiān.",
          "english": "We live in an HDB flat. It has three rooms."
        },
        {
          "speaker": "B",
          "hanzi": "客厅真干净。这个沙发是新的吗？",
          "pinyin": "Kètīng zhēn gānjìng. Zhège shāfā shì xīn de ma?",
          "english": "The living room is so clean. Is this sofa new?"
        },
        {
          "speaker": "A",
          "hanzi": "对啊，上星期买的。",
          "pinyin": "Duì a, shàng xīngqī mǎi de.",
          "english": "Yes, I bought it last week."
        },
        {
          "speaker": "B",
          "hanzi": "厨房在哪里？我想喝水。",
          "pinyin": "Chúfáng zài nǎlǐ? Wǒ xiǎng hē shuǐ.",
          "english": "Where is the kitchen? I want some water."
        },
        {
          "speaker": "A",
          "hanzi": "在那边，冰箱里有水。",
          "pinyin": "Zài nàbiān, bīngxiāng lǐ yǒu shuǐ.",
          "english": "Over there. There's water in the fridge."
        }
      ],
      "questions": [
        {
          "id": "u19-d01-q1",
          "question": "What does B say about the living room?",
          "answer": "It is very clean",
          "distractors": [
            "It is too small",
            "It is too messy",
            "It is too hot"
          ]
        },
        {
          "id": "u19-d01-q2",
          "question": "Where is the water?",
          "answer": "In the fridge",
          "distractors": [
            "On the dining table",
            "In the bathroom",
            "On the sofa"
          ]
        }
      ]
    },
    {
      "id": "u19-d02",
      "title": "The broken aircon",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你的卧室太热了，怎么不开冷气？",
          "pinyin": "Nǐ de wòshì tài rè le, zěnme bù kāi lěngqì?",
          "english": "Your bedroom is too hot. Why don't you turn on the aircon?"
        },
        {
          "speaker": "B",
          "hanzi": "冷气坏了啦。",
          "pinyin": "Lěngqì huài le la.",
          "english": "The aircon is broken."
        },
        {
          "speaker": "A",
          "hanzi": "什么时候坏的？",
          "pinyin": "Shénme shíhou huài de?",
          "english": "When did it break?"
        },
        {
          "speaker": "B",
          "hanzi": "昨天晚上。我打电话了，明天有人来看。",
          "pinyin": "Zuótiān wǎnshang. Wǒ dǎ diànhuà le, míngtiān yǒu rén lái kàn.",
          "english": "Last night. I made a call. Someone is coming to look tomorrow."
        },
        {
          "speaker": "A",
          "hanzi": "那今天晚上你睡哪里？",
          "pinyin": "Nà jīntiān wǎnshang nǐ shuì nǎlǐ?",
          "english": "Then where will you sleep tonight?"
        },
        {
          "speaker": "B",
          "hanzi": "我睡客厅，客厅的冷气是好的。",
          "pinyin": "Wǒ shuì kètīng, kètīng de lěngqì shì hǎo de.",
          "english": "I'll sleep in the living room. Its aircon works."
        },
        {
          "speaker": "A",
          "hanzi": "好，那你早点睡吧。晚安！",
          "pinyin": "Hǎo, nà nǐ zǎo diǎn shuì ba. Wǎn'ān!",
          "english": "OK, then go to bed early. Good night!"
        }
      ],
