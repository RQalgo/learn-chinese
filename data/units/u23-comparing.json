  "dialogues": [
    {
      "id": "u23-d01",
      "title": "Choosing lunch",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "中午吃什么？米饭还是面条？",
          "pinyin": "Zhōngwǔ chī shénme? Mǐfàn háishi miàntiáo?",
          "english": "What shall we eat at noon? Rice or noodles?"
        },
        {
          "speaker": "B",
          "hanzi": "都可以啦。你想吃什么？",
          "pinyin": "Dōu kěyǐ la. Nǐ xiǎng chī shénme?",
          "english": "Either is fine. What do you want?"
        },
        {
          "speaker": "A",
          "hanzi": "我想吃面。楼下那家的面最好吃。",
          "pinyin": "Wǒ xiǎng chī miàn. Lóuxià nà jiā de miàn zuì hǎochī.",
          "english": "I want noodles. The noodles at the shop downstairs are the tastiest."
        },
        {
          "speaker": "B",
          "hanzi": "可是那家比较贵。",
          "pinyin": "Kěshì nà jiā bǐjiào guì.",
          "english": "But that shop is fairly expensive."
        },
        {
          "speaker": "A",
          "hanzi": "比旁边那家贵一点，不过更好吃。",
          "pinyin": "Bǐ pángbiān nà jiā guì yìdiǎn, búguò gèng hǎochī.",
          "english": "A bit pricier than the one next door, but even tastier."
        },
        {
          "speaker": "B",
          "hanzi": "好，那就去楼下那家吧。",
          "pinyin": "Hǎo, nà jiù qù lóuxià nà jiā ba.",
          "english": "OK, then let's go to the one downstairs."
        },
        {
          "speaker": "A",
          "hanzi": "太好了，快走吧！",
          "pinyin": "Tài hǎo le, kuài zǒu ba!",
          "english": "Great, let's go quickly!"
        }
      ],
      "questions": [
        {
          "id": "u23-d01-q1",
          "question": "Why does B hesitate about the shop downstairs?",
          "answer": "It is fairly expensive",
          "distractors": [
            "It is far away",
            "It is always full",
            "It is too slow"
          ]
        },
        {
          "id": "u23-d01-q2",
          "question": "What do they decide?",
          "answer": "Noodles at the shop downstairs",
          "distractors": [
            "Rice at the shop next door",
            "Coffee in the office",
            "Noodles at home"
          ]
        }
      ]
    },
    {
      "id": "u23-d02",
      "title": "Getting to the airport",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "去机场，我们坐地铁还是搭德士？",
          "pinyin": "Qù jīchǎng, wǒmen zuò dìtiě háishi dā déshì?",
          "english": "To the airport, shall we take the MRT or a taxi?"
        },
        {
          "speaker": "B",
          "hanzi": "德士比地铁快，不过贵很多。",
          "pinyin": "Déshì bǐ dìtiě kuài, búguò guì hěn duō.",
          "english": "A taxi is faster than the MRT, but much more expensive."
        },
        {
          "speaker": "A",
          "hanzi": "这里到机场远吗？",
          "pinyin": "Zhèlǐ dào jīchǎng yuǎn ma?",
          "english": "Is it far from here to the airport?"
        },
        {
          "speaker": "B",
          "hanzi": "不太远，坐地铁四十分钟。",
          "pinyin": "Bú tài yuǎn, zuò dìtiě sìshí fēnzhōng.",
          "english": "Not too far. Forty minutes by MRT."
        },
        {
          "speaker": "A",
          "hanzi": "德士呢？",
          "pinyin": "Déshì ne?",
          "english": "And by taxi?"
        },
        {
          "speaker": "B",
          "hanzi": "差不多二十分钟，可是要四十块。",
          "pinyin": "Chàbuduō èrshí fēnzhōng, kěshì yào sìshí kuài.",
          "english": "About twenty minutes, but it costs forty dollars."
        },
        {
          "speaker": "A",
          "hanzi": "那我们坐地铁吧，便宜一点。",
          "pinyin": "Nà wǒmen zuò dìtiě ba, piányi yìdiǎn.",
          "english": "Then let's take the MRT. It's a bit cheaper."
        },
        {
          "speaker": "B",
          "hanzi": "好啊，我同意。",
          "pinyin": "Hǎo a, wǒ tóngyì.",
          "english": "OK, I agree."
        }
      ],
      "questions": [
