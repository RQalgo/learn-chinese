    {
      "id": "u15-d01",
      "title": "What do you do?",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你在哪里工作？",
          "pinyin": "Nǐ zài nǎlǐ gōngzuò?",
          "english": "Where do you work?"
        },
        {
          "speaker": "B",
          "hanzi": "我在一家公司工作。",
          "pinyin": "Wǒ zài yì jiā gōngsī gōngzuò.",
          "english": "I work at a company."
        },
        {
          "speaker": "A",
          "hanzi": "你做什么工作？",
          "pinyin": "Nǐ zuò shénme gōngzuò?",
          "english": "What job do you do?"
        },
        {
          "speaker": "B",
          "hanzi": "我是经理。你呢？",
          "pinyin": "Wǒ shì jīnglǐ. Nǐ ne?",
          "english": "I'm a manager. And you?"
        },
        {
          "speaker": "A",
          "hanzi": "我是老师。",
          "pinyin": "Wǒ shì lǎoshī.",
          "english": "I'm a teacher."
        },
        {
          "speaker": "B",
          "hanzi": "你每天几点下班？",
          "pinyin": "Nǐ měitiān jǐ diǎn xiàbān?",
          "english": "What time do you finish work every day?"
        },
        {
          "speaker": "A",
          "hanzi": "我每天四点下班。",
          "pinyin": "Wǒ měitiān sì diǎn xiàbān.",
          "english": "I finish at four every day."
        }
      ],
