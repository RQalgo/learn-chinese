      "title": "A busy day",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你今天忙吗？",
          "pinyin": "Nǐ jīntiān máng ma?",
          "english": "Are you busy today?"
        },
        {
          "speaker": "B",
          "hanzi": "很忙，我三点开会。",
          "pinyin": "Hěn máng, wǒ sān diǎn kāihuì.",
          "english": "Very busy, I have a meeting at three."
        },
        {
          "speaker": "A",
          "hanzi": "老板也去吗？",
          "pinyin": "Lǎobǎn yě qù ma?",
          "english": "Is the boss going too?"
        },
        {
          "speaker": "B",
          "hanzi": "去，经理也去。",
          "pinyin": "Qù, jīnglǐ yě qù.",
          "english": "Yes, the manager is going too."
        },
        {
          "speaker": "A",
          "hanzi": "那你几点下班？",
          "pinyin": "Nà nǐ jǐ diǎn xiàbān?",
          "english": "Then what time do you finish work?"
        },
        {
          "speaker": "B",
          "hanzi": "开会以后就下班。",
