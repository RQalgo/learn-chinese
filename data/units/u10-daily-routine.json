  "dialogues": [
    {
      "id": "u10-d01",
      "title": "Getting up",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你每天几点起床？",
          "pinyin": "Nǐ měitiān jǐ diǎn qǐchuáng?",
          "english": "What time do you get up every day?"
        },
        {
          "speaker": "B",
          "hanzi": "我每天六点半起床。",
          "pinyin": "Wǒ měitiān liù diǎn bàn qǐchuáng.",
          "english": "I get up at half past six every day."
        },
        {
          "speaker": "A",
          "hanzi": "这么早！你吃早餐吗？",
          "pinyin": "Zhème zǎo! Nǐ chī zǎocān ma?",
          "english": "So early! Do you eat breakfast?"
        },
        {
          "speaker": "B",
          "hanzi": "吃，我吃面条，喝茶。",
          "pinyin": "Chī, wǒ chī miàntiáo, hē chá.",
          "english": "Yes, I eat noodles and drink tea."
        },
        {
          "speaker": "A",
          "hanzi": "我七点才起床，不吃早餐。",
          "pinyin": "Wǒ qī diǎn cái qǐchuáng, bù chī zǎocān.",
          "english": "I don't get up until seven and I skip breakfast."
        }
      ],
      "questions": [
