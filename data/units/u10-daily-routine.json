    {
      "id": "u10-d02",
      "title": "A late night",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你昨天晚上几点睡觉？",
          "pinyin": "Nǐ zuótiān wǎnshang jǐ diǎn shuìjiào?",
          "english": "What time did you go to sleep last night?"
        },
        {
          "speaker": "B",
          "hanzi": "我十二点才睡觉。",
          "pinyin": "Wǒ shí'èr diǎn cái shuìjiào.",
          "english": "I didn't sleep until twelve."
        },
        {
          "speaker": "A",
          "hanzi": "怎么这么晚？",
          "pinyin": "Zěnme zhème wǎn?",
          "english": "Why so late?"
        },
        {
          "speaker": "B",
          "hanzi": "我睡不着。",
          "pinyin": "Wǒ shuì bu zháo.",
          "english": "I couldn't fall asleep."
        },
        {
          "speaker": "A",
          "hanzi": "那你今天几点起床？",
