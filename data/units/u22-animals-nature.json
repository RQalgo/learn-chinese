    {
      "id": "u22-d02",
      "title": "A trip to the zoo",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "这个星期六你有空吗？",
          "pinyin": "Zhège xīngqīliù nǐ yǒu kòng ma?",
          "english": "Are you free this Saturday?"
        },
        {
          "speaker": "B",
          "hanzi": "有，你想做什么？",
          "pinyin": "Yǒu, nǐ xiǎng zuò shénme?",
          "english": "Yes. What do you want to do?"
        },
        {
          "speaker": "A",
          "hanzi": "我想去动物园看熊猫。",
          "pinyin": "Wǒ xiǎng qù dòngwùyuán kàn xióngmāo.",
          "english": "I want to go to the zoo to see the pandas."
        },
        {
          "speaker": "B",
          "hanzi": "好啊！那里有老虎吗？",
          "pinyin": "Hǎo a! Nàlǐ yǒu lǎohǔ ma?",
          "english": "Great! Are there tigers there?"
        },
        {
          "speaker": "A",
          "hanzi": "有啊，还有很多鸟。",
          "pinyin": "Yǒu a, hái yǒu hěn duō niǎo.",
          "english": "Yes, and lots of birds too."
        },
        {
          "speaker": "B",
          "hanzi": "我们几点出发？",
          "pinyin": "Wǒmen jǐ diǎn chūfā?",
          "english": "What time shall we set off?"
        },
        {
          "speaker": "A",
          "hanzi": "早上九点吧，下午可能会下雨。",
          "pinyin": "Zǎoshang jiǔ diǎn ba, xiàwǔ kěnéng huì xià yǔ.",
          "english": "Nine in the morning. It might rain in the afternoon."
        }
      ],
