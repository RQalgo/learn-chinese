  "dialogues": [
    {
      "id": "u22-d01",
      "title": "Walking the dog",
      "lines": [
        {
          "speaker": "A",
          "hanzi": "你家的狗叫什么名字？",
          "pinyin": "Nǐ jiā de gǒu jiào shénme míngzi?",
          "english": "What is your dog's name?"
        },
        {
          "speaker": "B",
          "hanzi": "它叫豆豆，今年三岁了。",
          "pinyin": "Tā jiào Dòudou, jīnnián sān suì le.",
          "english": "It's called Doudou. It's three this year."
        },
        {
          "speaker": "A",
          "hanzi": "它真可爱！我可以摸它吗？",
          "pinyin": "Tā zhēn kě'ài! Wǒ kěyǐ mō tā ma?",
          "english": "It's so cute! Can I pet it?"
        },
        {
          "speaker": "B",
          "hanzi": "可以啊，它很喜欢人。",
          "pinyin": "Kěyǐ a, tā hěn xǐhuan rén.",
          "english": "Sure, it loves people."
        },
        {
          "speaker": "A",
          "hanzi": "你每天都遛狗吗？",
          "pinyin": "Nǐ měi tiān dōu liù gǒu ma?",
          "english": "Do you walk it every day?"
        },
        {
          "speaker": "B",
          "hanzi": "对，早上一次，晚上一次。",
          "pinyin": "Duì, zǎoshang yí cì, wǎnshang yí cì.",
          "english": "Yes, once in the morning and once in the evening."
        },
        {
          "speaker": "A",
          "hanzi": "公园里的花也很漂亮。",
          "pinyin": "Gōngyuán lǐ de huā yě hěn piàoliang.",
          "english": "The flowers in the park are pretty too."
        }
      ],
      "questions": [
        {
          "id": "u22-d01-q1",
          "question": "How old is the dog?",
          "answer": "Three",
